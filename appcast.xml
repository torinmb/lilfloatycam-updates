        <item>
            <title>1.8</title>
            <pubDate>Mon, 19 Oct 2026 17:35:48 -0500</pubDate>
            <sparkle:fullReleaseNotesLink>https://torinmb.github.io/lilfloatycam-updates/changelog/</sparkle:fullReleaseNotesLink>
            <sparkle:version>10</sparkle:version>
            <sparkle:shortVersionString>1.8</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- With Remove Background on, only you catch clicks and drags; clicks outside your cutout pass through to the apps underneath
- Resize and corner radius grips appear when you hover the cutout (hidden in Streaming Mode)
]]></description>
